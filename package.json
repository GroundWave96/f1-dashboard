{
  "name": "f1-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-assets.mjs",
    "typecheck:cloudflare": "tsc -p tsconfig.cloudflare.json",
    "pages:dev": "next build && wrangler pages dev out --d1 DB=d0693d4f-6017-4bc8-924d-21ba8113441e --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply f1dash-db --local --config worker/wrangler.toml --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply f1dash-db --remote --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  }
}
